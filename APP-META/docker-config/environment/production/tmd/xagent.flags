-application=aliyun-com-base
-module_config_uri=http://status.tmd.alibaba-inc.com:24066
-module_server_addr=run/xagent.sock
-module_server_port=9111
-module_server_rcvbuf_size=640
-module_server_thread_num=0
#-status_taobao_file=/home/admin/xagent/status.taobao
-persistence_path=/home/admin/xagent/data
-redis_sentinel=security-faraday-sentinel-0.alibaba-inc.com:26379,security-faraday-sentinel-1.alibaba-inc.com:26379,security-faraday-sentinel-2.alibaba-inc.com:26379
-redis_cluster=faraday
-debug_interface=127.0.0.1:20018
-hscan_once_count=1024
-clean_once_max=40960
#-cgroup_sh=bin/cgroup.sh
-health_check_interval=5
-health_check_timeout=3
-max_cpu_usage_rate=20
-max_mem_usage_megabytes=1024